{
    "name": "naokitsuchiya/bear-mcp",
    "description": "Serve a BEAR.Sunday application as an MCP server",
    "license": "MIT",
    "authors": [
        {
            "name": "Naoki Tsuchiya",
            "email": "ntsuchiya1105@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "mcp/sdk": "^0.6",
        "bear/resource": "^1.21",
        "bear/app-meta": "^1.0",
        "bear/package": "^1.13",
        "ray/di": "^2.18"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "suggest": {
        "bear/tool-use": "Reuse #[Tool] descriptions and ALPS-based parameter docs for MCP"
    },
    "bin": [
        "bin/bear-mcp"
    ],
    "autoload": {
        "psr-4": {
            "NaokiTsuchiya\\BEAR\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NaokiTsuchiya\\BEAR\\Mcp\\": "tests/",
            "FakeVendor\\FakeProject\\": "tests/Fake/fake-app/src/",
            "FakeVendor\\InvalidProject\\": "tests/Fake/invalid-app/src/",
            "FakeVendor\\DupProject\\": "tests/Fake/dup-app/src/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
